# Copiar a .env. Las variables del entorno tienen prioridad sobre este archivo.
# Adaptador para Windows con .NET Framework 4.7.2 o posterior.
APP_ENV=local
APP_TIMEZONE=America/Lima
DB_DIALECT=mssql
DB_DRIVER=System.Data.SqlClient
DB_HOST=localhost
DB_PORT=1433
DB_NAME=REEMPLAZAR_NOMBRE_BASE
DB_SCHEMA=dbo
# windows usa la identidad del proceso; sql requiere usuario y contrasena propios.
DB_AUTH=windows
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Mantener false con un certificado confiable. true solo para laboratorio.
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECT_TIMEOUT_SECONDS=10
DB_QUERY_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_ECHO=false
